{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepseek-chat",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-17",
  "keep_vars": true,
  "vars": {},
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat",
      "database_id": "c29f816d-5fe1-493d-a56a-65743dec41fb",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat" }],
}
