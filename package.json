{
  "name": "deepseek-chat",
  "version": "0.1.1",
  "description": "Deepseek Chat",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:worker": "wrangler dev",
    "build": "node scripts/build.mjs",
    "type": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint src server shared rspack.config.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "deploy": "pnpm build && pnpm deploy:worker",
    "deploy:worker": "pnpm db:migrate:remote && wrangler deploy --config wrangler.jsonc && node scripts/migrate-invite-codes.mjs --remote --clear-ciphertext",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "secret:put": "wrangler secret put",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc && node scripts/migrate-invite-codes.mjs --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc && node scripts/migrate-invite-codes.mjs --remote",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "hono": "^4.13.18",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "esbuild": "^0.28.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2",
    "wrangler": "^4.162.0"
  }
}
